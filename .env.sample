# Local server settings. start-dev.sh copies this file to .env on first run.
# Keep local edits in .env; existing .env files are never overwritten.
# Empty display names disable the corresponding learned ONNX slot.

NAPOLEON_POLICY_1_DISPLAY_NAME=RL v740
NAPOLEON_POLICY_1_ONNX_PATH=/home/eletim/napoleon_runs/rl-v100-to-v1000/evaluations/policy-v740/policy.onnx
NAPOLEON_POLICY_1_METADATA_PATH=/home/eletim/napoleon_runs/rl-v100-to-v1000/evaluations/policy-v740/policy.json

