{
  "name": "napoleon-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./start-dev.sh",
    "dev:raw": "pnpm --parallel --filter @napoleon/server --filter @napoleon/web dev",
    "self-play:generate": "pnpm --filter @napoleon/self-play-cli... build && pnpm --filter @napoleon/self-play-cli exec node dist/index.js",
    "benchmark:playing-cache": "pnpm --filter @napoleon/training-data... build && node scripts/benchmark-playing-self-play-cache.mjs",
    "bidding-q:counterfactual": "pnpm --filter @napoleon/training-data... --filter @napoleon/policy-onnx... build && node scripts/generate-bidding-q-counterfactual-dataset.mjs",
    "bidding-margin:fixed-hand": "pnpm --filter @napoleon/training-data... build && node scripts/generate-fixed-hand-bidding-margin-dataset.mjs",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}
