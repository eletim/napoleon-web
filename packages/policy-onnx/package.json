    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@napoleon/ai": "workspace:*",
    "@napoleon/ai-observation": "workspace:*",
    "@napoleon/game-core": "workspace:*",
    "@napoleon/training-data": "workspace:*",
    "onnxruntime-node": "1.27.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
