{
  "name": "@napoleon/policy-onnx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./test-fixtures": {
      "types": "./src/testFixtures.ts",
      "development": "./src/testFixtures.ts",
      "import": "./dist/testFixtures.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
